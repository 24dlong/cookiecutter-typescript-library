{
  "compilerOptions": {
    "target": "ES2021",
    // The published dist/ is plain ESM, and Node's ESM loader can't resolve
    // extensionless specifiers, so consumers that load this package without a
    // bundler (e.g. Vitest, Node scripts) would fail with ERR_MODULE_NOT_FOUND.
    // NodeNext (not "bundler") makes tsc require explicit extensions on relative
    // imports. Source imports the real `.ts` files, and
    // rewriteRelativeImportExtensions rewrites them to `.js` in dist/.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts"],
  "exclude": [
    "dist",
    "coverage",
    "node_modules",
    ".cache",
    ".prettier",
    ".turbo"
  ]
}
